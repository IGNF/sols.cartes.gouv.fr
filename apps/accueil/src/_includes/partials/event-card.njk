{%- set eventStrings = t.accueil.agenda -%}
<div class="fr-card sols-event"{{ frLang | safe }}>
  <div class="sols-event__date" aria-hidden="true">
    <span class="sols-event__day">{{ event.date | eventDay }}</span>
    <span class="sols-event__month">{{ event.date | eventMonth(locale) }}</span>
    <span class="sols-event__time">{{ event.time | eventTime(locale) }}</span>
  </div>
  <div class="fr-card__body">
    <div class="fr-card__content">
      <h3 class="fr-card__title">{{ event.title }}</h3>
      <p class="fr-card__desc">{{ event.summary }}</p>
      <div class="fr-card__start">
        <p class="fr-badge fr-badge--sm fr-badge--blue-ecume"{% if frLang %} lang="{{ locale }}"{% endif %}>{{ eventStrings.types[event.type] }}</p>
        <p class="fr-sr-only"{% if frLang %} lang="{{ locale }}"{% endif %}><time datetime="{{ event.date }}T{{ event.time }}">{{ event.date | dateLong(locale) }}, {{ event.time | eventTime(locale) }}</time></p>
      </div>
      <div class="fr-card__end">
        <p class="fr-card__detail {{ accueil.agenda.icons.place }}"><span class="fr-sr-only"{% if frLang %} lang="{{ locale }}"{% endif %}>{{ eventStrings.placeLabel }} </span>{{ event.place }}</p>
      </div>
    </div>
    <div class="fr-card__footer">
      <a class="fr-btn fr-btn--sm" href="{{ event.href | localize(locale) }}"{% if frLang %} lang="{{ locale }}"{% endif %}>{{ eventStrings.actions[event.action] }}</a>
    </div>
  </div>
</div>
