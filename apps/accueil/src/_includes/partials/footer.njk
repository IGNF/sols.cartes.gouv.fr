{%- set linkLocale = "" if shared else locale -%}
{%- set homeHref = site.header.brandLink | localize(linkLocale) -%}
<footer class="fr-footer" role="contentinfo" id="pied-de-page">
  <div class="fr-container">
    <div class="fr-footer__body">
      <div class="fr-footer__brand fr-enlarge-link">
        <a href="{{ homeHref }}" title="{{ t.footer.homeLinkTitle }}">
          <p class="fr-logo">{{ site.header.brand | join("<br>") | safe }}</p>
        </a>
      </div>
      <div class="fr-footer__content">
        <p class="fr-footer__content-desc">{{ t.footer.description }}</p>
        <ul class="fr-footer__content-list">
          {%- for link in site.footer.contentLinks %}
          <li class="fr-footer__content-item">
            <a class="fr-footer__content-link" href="{{ link.href }}" target="_blank" rel="noopener external" title="{{ link.label }} - {{ t.newWindow }}">{{ link.label }}</a>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </div>
    <div class="fr-footer__partners">
      <h2 class="fr-footer__partners-title">{{ t.footer.partnersTitle }}</h2>
      <div class="fr-footer__partners-logos">
        <div class="fr-footer__partners-sub">
          <ul>
            {%- for partner in site.footer.partners %}
            <li>
              <a class="fr-footer__partners-link" href="{{ partner.href }}" target="_blank" rel="noopener external" title="{{ partner.name }} - {{ t.newWindow }}">
                <img class="fr-footer__logo sols-partner-logo" src="{{ partner.logo }}" alt="{{ partner.name }}">
              </a>
            </li>
            {%- endfor %}
          </ul>
        </div>
      </div>
    </div>
    <div class="fr-footer__bottom">
      <ul class="fr-footer__bottom-list">
        {%- for link in site.footer.bottomLinks %}
        {%- set href = link.href | localize(linkLocale) %}
        <li class="fr-footer__bottom-item">
          {%- if link.external %}
          <a class="fr-footer__bottom-link" href="{{ href }}"{% if not shared and locale != site.defaultLanguage %} hreflang="{{ site.defaultLanguage }}"{% endif %} target="_blank" rel="noopener external" title="{{ t.footer.bottomLinks[link.key] }} - {{ t.newWindow }}">{{ t.footer.bottomLinks[link.key] }}</a>
          {%- else %}
          <a class="fr-footer__bottom-link" href="{{ href }}"{% if page.url == href %} aria-current="page"{% endif %}>{{ t.footer.bottomLinks[link.key] }}</a>
          {%- endif %}
        </li>
        {%- endfor %}
        <li class="fr-footer__bottom-item">
          <button type="button" class="fr-footer__bottom-link fr-icon-theme-fill fr-btn--icon-left" aria-controls="fr-theme-modal" data-fr-opened="false">{{ t.display.button }}</button>
        </li>
      </ul>
      <div class="fr-footer__bottom-copy">
        <p>{{ t.footer.licence.text }} <a href="{{ site.footer.licenceHref }}" target="_blank" rel="noopener external" title="{{ t.footer.licence.label }} - {{ t.newWindow }}">{{ t.footer.licence.label }}</a></p>
      </div>
    </div>
  </div>
</footer>
<dialog id="fr-theme-modal" class="fr-modal" aria-labelledby="fr-theme-modal-title">
  <div class="fr-container fr-container--fluid fr-container-md">
    <div class="fr-grid-row fr-grid-row--center">
      <div class="fr-col-12 fr-col-md-6 fr-col-lg-4">
        <div class="fr-modal__body">
          <div class="fr-modal__header">
            <button aria-controls="fr-theme-modal" title="{{ t.header.close }}" type="button" class="fr-btn--close fr-btn">{{ t.header.close }}</button>
          </div>
          <div class="fr-modal__content">
            <h2 id="fr-theme-modal-title" class="fr-modal__title">{{ t.display.title }}</h2>
            <div id="fr-display" class="fr-display">
              <fieldset class="fr-fieldset" id="display-fieldset">
                <legend class="fr-fieldset__legend--regular fr-fieldset__legend" id="display-fieldset-legend">{{ t.display.legend }}</legend>
                {%- for theme in site.display.themes %}
                <div class="fr-fieldset__element">
                  <div class="fr-radio-group fr-radio-rich">
                    <input value="{{ theme.value }}" type="radio" id="fr-radios-theme-{{ theme.value }}" name="fr-radios-theme">
                    <label class="fr-label" for="fr-radios-theme-{{ theme.value }}">{{ t.display[theme.value] }}{% if theme.value == "system" %}<span class="fr-hint-text">{{ t.display.systemHint }}</span>{% endif %}</label>
                    <div class="fr-radio-rich__pictogram">
                      {%- set pictogram = theme.pictogram %}
                      {% include "partials/pictogram.njk" %}
                    </div>
                  </div>
                </div>
                {%- endfor %}
              </fieldset>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>
