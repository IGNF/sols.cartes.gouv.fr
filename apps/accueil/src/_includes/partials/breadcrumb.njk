<nav role="navigation" class="fr-breadcrumb" aria-label="{{ t.breadcrumb.label }}">
  <button type="button" class="fr-breadcrumb__button" aria-expanded="false" aria-controls="fil-d-ariane">{{ t.breadcrumb.button }}</button>
  <div class="fr-collapse" id="fil-d-ariane">
    <ol class="fr-breadcrumb__list">
      <li><a class="fr-breadcrumb__link" href="{{ site.sections.accueil | locale_url }}">{{ t.breadcrumb.accueil }}</a></li>
      {%- for crumb in breadcrumb or [] %}
      <li><a class="fr-breadcrumb__link" href="{{ crumb.href | locale_url }}">{{ crumb.label }}</a></li>
      {%- endfor %}
      <li><a class="fr-breadcrumb__link" aria-current="page">{{ heading }}</a></li>
    </ol>
  </div>
</nav>
