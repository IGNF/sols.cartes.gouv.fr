---
layout: layouts/page.njk
---
<ul>
  {%- for link in site.mainSections %}
  <li><a href="{{ link.href | locale_url }}">{{ t.mainSections[link.key] }}</a></li>
  {%- endfor %}
  <li><a href="{{ site.sections.articles | locale_url }}">{{ t.pages.articles.title }}</a></li>
  {%- for link in site.footer.bottomLinks %}
  {%- if link.external %}
  <li><a href="{{ link.href }}"{% if locale != site.defaultLanguage %} hreflang="{{ site.defaultLanguage }}"{% endif %} target="_blank" rel="noopener external" title="{{ t.footer.bottomLinks[link.key] }} - {{ t.newWindow }}">{{ t.footer.bottomLinks[link.key] }}</a></li>
  {%- else %}
  {%- set href = link.href | locale_url %}
  <li><a href="{{ href }}"{% if page.url == href %} aria-current="page"{% endif %}>{{ t.footer.bottomLinks[link.key] }}</a></li>
  {%- endif %}
  {%- endfor %}
</ul>
