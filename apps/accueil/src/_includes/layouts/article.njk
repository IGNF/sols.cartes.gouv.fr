---
layout: layouts/base.njk
---
{%- set breadcrumb = [{ label: t.breadcrumb.articles, href: site.sections.articles }] -%}
<div class="fr-container fr-pb-8w">
  {% include "partials/breadcrumb.njk" %}
  <div class="fr-grid-row">
    <article class="fr-col-12 fr-col-lg-8">
      <h1>{{ heading }}</h1>
      <p class="fr-text--sm">{{ t.articles.published }} <time datetime="{{ page.date | dateIso }}">{{ page.date | dateLong(locale) }}</time></p>
      {{ content | safe }}
    </article>
  </div>
</div>
