---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all | sort(false, true, "url") %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    {%- if item.data.date %}
    <lastmod>{{ item.date | dateIso }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
{%- for path in [site.sections.rechercherUneDonnee, site.sections.explorerLesCartes] %}
  <url>
    <loc>{{ site.url }}{{ path }}</loc>
  </url>
{%- endfor %}
</urlset>
