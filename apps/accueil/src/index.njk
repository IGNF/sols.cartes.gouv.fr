---
layout: layouts/base.njk
title: Observatoire des sols
---
{%- set hero = accueil.hero -%}
<div class="sols-hero fr-py-8w">
  <div class="fr-container">
    <div class="fr-grid-row">
      <div class="fr-col-12 fr-col-lg-8">
        <p class="sols-overline">{{ hero.overline }}</p>
        <h1>{{ hero.title }}</h1>
        <p class="fr-text--lead">{{ hero.intro }}</p>
        <ul class="fr-btns-group fr-btns-group--inline-md">
          {%- for action in hero.actions %}
          <li><a class="fr-btn{% if not action.primary %} fr-btn--secondary{% endif %}" href="{{ action.href }}">{{ action.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>

{%- set service = accueil.service %}
<section class="fr-container fr-py-8w" aria-labelledby="titre-service">
  <p class="sols-overline">{{ service.overline }}</p>
  <h2 id="titre-service">{{ service.title }}</h2>
  <p>{{ service.intro }}</p>
  <ul class="fr-grid-row fr-grid-row--gutters fr-raw-list">
    {%- for item in service.items %}
    <li class="fr-col-12 fr-col-md-4">
      <div class="fr-tile">
        <div class="fr-tile__body">
          <div class="fr-tile__content">
            <h3 class="fr-tile__title">{{ item.title }}</h3>
            <p class="fr-tile__desc">{{ item.desc }}</p>
          </div>
        </div>
        <div class="fr-tile__header">
          <div class="fr-tile__pictogram">
            {%- set pictogram = item.pictogram %}
            {% include "partials/pictogram.njk" %}
          </div>
        </div>
      </div>
    </li>
    {%- endfor %}
  </ul>
</section>

{%- set donnees = accueil.donnees %}
<section class="fr-container fr-pb-8w" aria-labelledby="titre-donnees">
  <p class="sols-overline">{{ donnees.overline }}</p>
  <h2 id="titre-donnees">{{ donnees.title }}</h2>
  <p>{{ donnees.intro }}</p>
  <ul class="fr-grid-row fr-grid-row--gutters fr-raw-list">
    {%- for item in donnees.items %}
    <li class="fr-col-12 fr-col-md-4">
      <div class="fr-card fr-enlarge-link">
        <div class="fr-card__body">
          <div class="fr-card__content">
            <h3 class="fr-card__title"><a href="{{ donnees.href }}">{{ item.title }}</a></h3>
            <p class="fr-card__desc">{{ item.desc }}</p>
          </div>
        </div>
      </div>
    </li>
    {%- endfor %}
  </ul>
  <p class="fr-mt-4w"><a class="fr-btn fr-btn--tertiary" href="{{ donnees.href }}">{{ donnees.allLabel }}</a></p>
</section>

{%- set articles = accueil.articles %}
<section class="fr-container fr-pb-8w" aria-labelledby="titre-articles">
  <p class="sols-overline">{{ articles.overline }}</p>
  <h2 id="titre-articles">{{ articles.title }}</h2>
  <ul class="fr-grid-row fr-grid-row--gutters fr-raw-list">
    {%- for article in collections.articles.slice(0, articles.max) %}
    <li class="fr-col-12 fr-col-md-4">
      {%- set headingLevel = "h3" %}
      {% include "partials/article-card.njk" %}
    </li>
    {%- endfor %}
  </ul>
  <p class="fr-mt-4w"><a class="fr-btn fr-btn--tertiary" href="{{ articles.href }}">{{ articles.allLabel }}</a></p>
</section>

{%- set gissol = accueil.gissol %}
<section class="fr-container fr-pb-8w" aria-labelledby="titre-gissol">
  <div class="fr-callout fr-callout--green-emeraude">
    <h2 class="fr-callout__title" id="titre-gissol">{{ gissol.title }}</h2>
    <p class="fr-callout__text">{{ gissol.text }}</p>
    <a class="fr-btn" href="{{ gissol.href }}" target="_blank" rel="noopener external" title="{{ gissol.label }} - nouvelle fenêtre">{{ gissol.label }}</a>
  </div>
</section>
